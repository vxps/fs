# Local mode: leave DATABASE_URL blank for SQLite; database file is ignored by git.
DATABASE_URL=
JWT_SECRET=local-fitspot-development-secret-change-before-deploy
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development
SEED_DEMO=true

# Public demo: set these as secret environment variables in Render (NOT in GitHub).
# PostgreSQL URL from Neon must use SSL; keep the full ?sslmode=require... query string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# JWT_SECRET=32-plus-random-characters
# ALLOWED_ORIGINS=https://YOUR-SITE.netlify.app
# ENVIRONMENT=production
# SEED_DEMO=true
# ADMIN_EMAIL=your-private-admin@example.com
# ADMIN_PASSWORD=unique-12-plus-character-password
